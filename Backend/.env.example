# Configuration de l'application
APP_NAME=Patro
APP_URL=http://localhost/Projet_patro-1
APP_DEBUG=false
APP_FORCE_HTTPS=false

# Configuration de la base de données
DB_HOST=localhost
DB_NAME=projet_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Configuration de session admin
ADMIN_SESSION_TIMEOUT_SECONDS=3600
LOG_MAX_BYTES=5242880

# Images d'activite (stockage hors webroot: storage/activites)
ACTIVITE_STORAGE_DIR=storage/activites
ACTIVITE_MAX_SIZE_MB=5

# Configuration des inscriptions
IDENTIFIANT_ORDER_DIGITS=3
ANIMATEUR_CODE_LENGTH=10

# Configuration CinetPay (paiement en ligne)
CINETPAY_ENABLED=false
CINETPAY_APIKEY=
CINETPAY_SITE_ID=
CINETPAY_CURRENCY=XOF
CINETPAY_CHANNELS=MOBILE_MONEY
CINETPAY_API_BASE_URL=https://api-checkout.cinetpay.com/v2
